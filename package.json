    "url": "https://github.com/theluckystrike/silver-price-per-gram-mcp"
  },
  "homepage": "https://goldgramprice.com",
  "bin": {
    "silver-price-per-gram-mcp": "dist/stdio.js"
  },
  "main": "dist/stdio.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
